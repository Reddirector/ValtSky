<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="?attr/valtskyBorder" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="8dp" />
                <gradient
                    android:startColor="?attr/valtskyPrimaryAccent"
                    android:endColor="?attr/valtskySecondaryAccent"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
