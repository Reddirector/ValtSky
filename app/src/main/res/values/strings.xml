    <!-- Large File Handling -->
    <string name="large_file_label">Large File Handling</string>
    <string name="large_file_compress">Compress</string>
    <string name="large_file_compress_desc">Reduces file size before uploading. May lower video quality slightly. Best for saving Telegram storage.</string>
    <string name="large_file_split">Split</string>
    <string name="large_file_split_desc">Splits large files into parts and uploads each separately. No quality loss. Parts appear as multiple messages in your channel.</string>

