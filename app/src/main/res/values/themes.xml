<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ValtSky" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/light_primary_accent</item>
        <item name="colorPrimaryVariant">@color/light_secondary_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/light_secondary_accent</item>
        <item name="colorSecondaryVariant">@color/light_primary_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/valtskyBackground</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Custom Attributes -->
        <item name="valtskyBackground">@color/light_background</item>
        <item name="valtskySurface">@color/light_surface</item>
        <item name="valtskyBorder">@color/light_border</item>
        <item name="valtskyPrimaryAccent">@color/light_primary_accent</item>
        <item name="valtskySecondaryAccent">@color/light_secondary_accent</item>
        <item name="valtskyTextPrimary">@color/light_text_primary</item>
        <item name="valtskyTextSecondary">@color/light_text_secondary</item>
        <item name="valtskySuccess">@color/light_success</item>
        <item name="valtskyError">@color/light_error</item>
        <item name="valtskyWarning">@color/light_warning</item>
        <item name="valtskyElevatedSurface">@color/light_surface</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
