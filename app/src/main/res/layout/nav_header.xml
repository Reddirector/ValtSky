<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:background="?attr/valtskySurface"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/Theme.ValtSky">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_cloud_upload"
        android:background="@drawable/icon_container_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ValtSky"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="?attr/valtskyTextPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Telegram Gallery Backup"
        android:textSize="12sp"
        android:textColor="?attr/valtskyTextSecondary" />

</LinearLayout>
