<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/valtskyBackground">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/guideTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="?attr/valtskyGlassBackground"
        android:clipToPadding="false"
        app:tabIndicatorColor="?attr/valtskyPrimaryAccent"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabIndicator="@drawable/tab_indicator_rounded"
        app:tabSelectedTextColor="?attr/valtskyPrimaryAccent"
        app:tabTextColor="?attr/valtskyTextSecondary"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabRippleColor="@android:color/transparent"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/guideViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
