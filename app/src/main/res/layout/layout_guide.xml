                            android:layout_height="wrap_content"
                            android:text="@string/guide_setup_channel_step2_title"
                            android:textStyle="bold"
                            android:textColor="?attr/valtskyTextPrimary"
                            android:layout_marginTop="16dp" />
                        <TextView
