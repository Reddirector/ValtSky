    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/valtskyBackground">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/guideTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/valtskySurface"
        app:tabIndicatorColor="?attr/valtskyPrimaryAccent"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="?attr/valtskyPrimaryAccent"
        app:tabTextColor="?attr/valtskyTextSecondary"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_setup" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_permissions" />

        <com.google.android.material.tabs.TabItem
